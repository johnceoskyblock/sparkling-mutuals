{
	"schemaVersion": 1,
	"id": "sparkling-mutuals",
	"version": "${version}",
	"name": "CJ’s Revenge",
	"description": "Local experimental Sparkling Mutuals build. 26.1.2 Safari entry dry run exchanges status only; no automatic entry. Use a separate test instance.",
	"authors": [
		"JohnCEO",
		"JohnKuudra"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/johnceoskyblock/sparkling-mutuals",
		"issues": "https://github.com/johnceoskyblock/sparkling-mutuals/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/sparkling-mutuals/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"value": "net.johnceo.sparklingmutuals.SparklingMutuals",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"sparkling-mutuals.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft}",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
