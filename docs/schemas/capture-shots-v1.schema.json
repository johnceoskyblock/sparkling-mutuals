{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capture-shots-v1.schema.json",
  "title": "Capture shot record v1 (one JSONL line)",
  "$defs": {
    "vector": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "properties": {
        "min": {
          "$ref": "#/$defs/vector"
        },
        "max": {
          "$ref": "#/$defs/vector"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "quaternion": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "w": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "additionalProperties": false
    },
    "pathPoint": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vector"
        },
        "tickOffset": {
          "type": "integer"
        }
      },
      "required": [
        "position",
        "tickOffset"
      ],
      "additionalProperties": false
    },
    "variant": {
      "enum": [
        "ordinary",
        "masterful"
      ]
    },
    "scenario": {
      "enum": [
        "unspecified",
        "stationary_level",
        "stationary_up",
        "stationary_down",
        "walking_forward",
        "walking_sideways",
        "moving_target",
        "solid_obstruction",
        "edge_obstruction",
        "rapid_inputs",
        "nearby_thrower",
        "hiding_comparison"
      ]
    },
    "split": {
      "enum": [
        "fit",
        "validation",
        "unassigned"
      ]
    },
    "unavailable": {
      "enum": [
        "not_exposed",
        "not_observed",
        "missing_base",
        "unloaded",
        "truncated"
      ]
    },
    "manual": {
      "enum": [
        "hit",
        "capture",
        "escape",
        "miss",
        "unknown"
      ]
    },
    "pose": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/vector"
        },
        "eye": {
          "$ref": "#/$defs/vector"
        },
        "camera": {
          "$ref": "#/$defs/vector"
        },
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        },
        "aim": {
          "$ref": "#/$defs/vector"
        },
        "velocity": {
          "$ref": "#/$defs/vector"
        },
        "onGround": {
          "type": "boolean"
        },
        "sneaking": {
          "type": "boolean"
        },
        "sprinting": {
          "type": "boolean"
        },
        "thirdPerson": {
          "type": "boolean"
        },
        "latencyMs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "latencyUnavailable": {
          "anyOf": [
            {
              "$ref": "#/$defs/unavailable"
            },
            {
              "type": "null"
            }
          ]
        },
        "crosshair": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "miss",
                    "block",
                    "entity"
                  ]
                },
                "position": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/vector"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "target": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,48}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "position",
                "target"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "nearbyPlayers": {
          "type": "integer"
        }
      },
      "required": [
        "position",
        "eye",
        "camera",
        "yaw",
        "pitch",
        "aim",
        "velocity",
        "onGround",
        "sneaking",
        "sprinting",
        "thirdPerson",
        "latencyMs",
        "latencyUnavailable",
        "crosshair",
        "nearbyPlayers"
      ],
      "additionalProperties": false
    },
    "feedbackValue": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "hit",
            "escape",
            "personal_capture",
            "shared_capture",
            "startle"
          ]
        },
        "species": {
          "type": "string",
          "maxLength": 128
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/variant"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "species",
        "variant"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "hand": {
          "enum": [
            "main",
            "off"
          ]
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "route": {
          "enum": [
            "air",
            "block"
          ]
        },
        "pose": {
          "$ref": "#/$defs/pose"
        },
        "scenario": {
          "$ref": "#/$defs/scenario"
        },
        "split": {
          "$ref": "#/$defs/split"
        },
        "standalone": {
          "type": "boolean"
        }
      },
      "required": [
        "token",
        "hand",
        "variant",
        "route",
        "pose",
        "scenario",
        "split",
        "standalone"
      ],
      "additionalProperties": false
    },
    "continuation": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "result": {
          "enum": [
            "pass",
            "success",
            "fail",
            "other"
          ]
        },
        "route": {
          "enum": [
            "air",
            "block"
          ]
        }
      },
      "required": [
        "token",
        "result",
        "route"
      ],
      "additionalProperties": false
    },
    "capsule": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "generation": {
          "type": "integer"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "action": {
          "enum": [
            "discovered",
            "sample",
            "removed"
          ]
        },
        "position": {
          "$ref": "#/$defs/vector"
        },
        "velocity": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector"
            },
            {
              "type": "null"
            }
          ]
        },
        "discovery": {
          "enum": [
            "spawn",
            "metadata",
            "bootstrap"
          ]
        },
        "flying": {
          "type": "boolean"
        },
        "removal": {
          "anyOf": [
            {
              "enum": [
                "server_remove",
                "unloaded",
                "window_expired",
            "recording_stopped"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "spawnMicros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "token",
        "generation",
        "variant",
        "action",
        "position",
        "velocity",
        "discovery",
        "flying",
        "removal",
        "spawnMicros"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "generation": {
          "type": "integer"
        },
        "species": {
          "type": "string",
          "maxLength": 128
        },
        "position": {
          "$ref": "#/$defs/vector"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "velocity": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "descriptor"
          ]
        }
      },
      "required": [
        "token",
        "generation",
        "species",
        "position",
        "bounds",
        "velocity",
        "source"
      ],
      "additionalProperties": false
    },
    "packet": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "update": {
          "enum": [
            "spawn",
            "move",
            "position_sync",
            "teleport",
            "motion",
            "metadata"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathPoint"
          },
          "maxItems": 64
        },
        "relative": {
          "type": "boolean"
        },
        "baseKnown": {
          "type": "boolean"
        },
        "motion": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector"
            },
            {
              "type": "null"
            }
          ]
        },
        "yaw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "pitch": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "relativeFlags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          },
          "maxItems": 16
        },
        "observedMicros": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "base": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "resolvedPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathPoint"
          },
          "maxItems": 64
        },
        "endPosition": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedEnd": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "token",
        "update",
        "points",
        "relative",
        "baseKnown",
        "motion",
        "yaw",
        "pitch",
        "relativeFlags",
        "observedMicros",
        "base",
        "truncated",
        "resolvedPoints",
        "endPosition",
        "resolvedEnd"
      ],
      "additionalProperties": false
    },
    "display_state": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "context": {
          "type": "string",
          "maxLength": 128
        },
        "translation": {
          "$ref": "#/$defs/vector"
        },
        "scale": {
          "$ref": "#/$defs/vector"
        },
        "leftRotation": {
          "$ref": "#/$defs/quaternion"
        },
        "rightRotation": {
          "$ref": "#/$defs/quaternion"
        },
        "interpolationDelay": {
          "type": "integer"
        },
        "interpolationDuration": {
          "type": "integer"
        },
        "positionInterpolationDuration": {
          "type": "integer"
        }
      },
      "required": [
        "token",
        "context",
        "translation",
        "scale",
        "leftRotation",
        "rightRotation",
        "interpolationDelay",
        "interpolationDuration",
        "positionInterpolationDuration"
      ],
      "additionalProperties": false
    },
    "obstruction": {
      "type": "object",
      "properties": {
        "shot": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,48}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "track": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,48}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "loaded": {
          "type": "boolean"
        },
        "from": {
          "$ref": "#/$defs/vector"
        },
        "to": {
          "$ref": "#/$defs/vector"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/vector"
            },
            {
              "type": "null"
            }
          ]
        },
        "face": {
          "anyOf": [
            {
              "enum": [
                "down",
                "up",
                "north",
                "south",
                "west",
                "east"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "block": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "bounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bounds"
          },
          "maxItems": 32
        }
      },
      "required": [
        "shot",
        "track",
        "loaded",
        "from",
        "to",
        "position",
        "face",
        "block",
        "bounds"
      ],
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "properties": {
        "feedback": {
          "$ref": "#/$defs/feedbackValue"
        },
        "dispatch": {
          "type": "integer"
        },
        "source": {
          "enum": [
            "game"
          ]
        }
      },
      "required": [
        "feedback",
        "dispatch",
        "source"
      ],
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "outcome": {
          "$ref": "#/$defs/manual"
        }
      },
      "required": [
        "token",
        "outcome"
      ],
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "properties": {
        "reason": {
          "enum": [
            "cache_backlog",
            "capsule_limit",
            "target_limit",
            "missing_base",
            "window_expired",
            "raw_path_truncated",
            "scan_pending"
          ]
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxInputs": {
          "type": "integer"
        },
        "maxEvents": {
          "type": "integer"
        },
        "maxBytes": {
          "type": "integer"
        },
        "bufferBytes": {
          "type": "integer"
        },
        "footerReserve": {
          "type": "integer"
        },
        "preInputMicros": {
          "type": "integer"
        },
        "sampleWindowMicros": {
          "type": "integer"
        },
        "associationMicros": {
          "type": "integer"
        },
        "feedbackMicros": {
          "type": "integer"
        },
        "associationDistanceSquared": {
          "type": "number"
        }
      },
      "required": [
        "maxInputs",
        "maxEvents",
        "maxBytes",
        "bufferBytes",
        "footerReserve",
        "preInputMicros",
        "sampleWindowMicros",
        "associationMicros",
        "feedbackMicros",
        "associationDistanceSquared"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "minecraft": {
          "enum": [
            "26.1.2",
            "26.2",
            "26.3"
          ]
        },
        "mod": {
          "type": "string",
          "maxLength": 128
        },
        "fabric": {
          "type": "string",
          "maxLength": 128
        },
        "dimension": {
          "type": "string",
          "maxLength": 128
        },
        "hideFlying": {
          "type": "boolean"
        },
        "hideGround": {
          "type": "boolean"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600
        },
        "recorderVersion": {
          "const": 1
        },
        "schemaVersion": {
          "const": 1
        },
        "modelVersion": {
          "type": "null"
        },
        "coordinates": {
          "const": "session_relative_game_axes"
        },
        "timeBasis": {
          "const": "client_monotonic_microseconds"
        }
      },
      "required": [
        "session",
        "minecraft",
        "mod",
        "fabric",
        "dimension",
        "hideFlying",
        "hideGround",
        "durationSeconds",
        "recorderVersion",
        "schemaVersion",
        "modelVersion",
        "coordinates",
        "timeBasis"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        },
        "scenario": {
          "$ref": "#/$defs/scenario"
        },
        "split": {
          "$ref": "#/$defs/split"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,48}$"
          },
          "maxItems": 16
        },
        "association": {
          "enum": [
            "unmatched",
            "candidate_unique",
            "ambiguous",
            "manual"
          ]
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 16
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manual"
          },
          "maxItems": 16
        }
      },
      "required": [
        "token",
        "variant",
        "scenario",
        "split",
        "tracks",
        "association",
        "feedback",
        "annotations"
      ],
      "additionalProperties": false
    },
    "player_state": {
      "type": "object",
      "properties": {
        "pose": {
          "$ref": "#/$defs/pose"
        }
      },
      "required": [
        "pose"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "header"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      },
      "required": [
        "type",
        "metadata",
        "limits"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "footer"
        },
        "sequence": {
          "type": "integer"
        },
        "micros": {
          "type": "integer"
        },
        "tick": {
          "type": "integer"
        },
        "reason": {
          "enum": [
            "user_stop",
            "export",
            "duration_limit",
            "input_limit",
            "event_limit",
            "byte_limit",
            "queue_limit",
            "world_change",
            "safari_exit",
            "disconnect",
            "shutdown",
            "error"
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "eventCount": {
          "type": "integer"
        },
        "inputCount": {
          "type": "integer"
        },
        "encodedBytesBeforeFooter": {
          "type": "integer"
        },
        "shots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          },
          "maxItems": 300
        },
        "gaps": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "sequence",
        "micros",
        "tick",
        "reason",
        "complete",
        "eventCount",
        "inputCount",
        "encodedBytesBeforeFooter",
        "shots",
        "gaps"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "sequence": {
          "type": "integer"
        },
        "micros": {
          "type": "integer"
        },
        "tick": {
          "type": "integer"
        },
        "kind": {
          "const": "input"
        },
        "data": {
          "$ref": "#/$defs/input"
        }
      },
      "required": [
        "type",
        "sequence",
        "micros",
        "tick",
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "sequence": {
          "type": "integer"
        },
        "micros": {
          "type": "integer"
        },
        "tick": {
          "type": "integer"
        },
        "kind": {
          "const": "continuation"
        },
        "data": {
          "$ref": "#/$defs/continuation"
        }
      },
      "required": [
        "type",
        "sequence",
        "micros",
        "tick",
        "kind",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "sequence": {
          "type": "integer"
        },
        "micros": {
          "type": "integer"
        },
        "tick": {
          "type": "integer"
        },
        "kind": {
